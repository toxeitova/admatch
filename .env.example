# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Secret key (sb_secret_…) из Project Settings → API Keys, или legacy service_role (eyJ…).
# Только на сервере (API-роуты, скрипты). Никогда не NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Публичный адрес сайта без слеша в конце (для ссылок в Telegram)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Telegram: токен от @BotFather и id чата/группы команды
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# true — тестовые блогеры (is_test=true) попадают в подбор. В проде: false
SHOW_TEST_DATA=true
